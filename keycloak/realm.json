{
  "realm": "commerce-demo",
  "enabled": true,
  "displayName": "Commerce authorization demo",
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      {
        "name": "reader"
      },
      {
        "name": "order-manager"
      }
    ]
  },
  "clients": [
    {
      "clientId": "customer-api",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "demo-customer-api-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": true,
      "fullScopeAllowed": true,
      "authorizationSettings": {
        "allowRemoteResourceManagement": true,
        "policyEnforcementMode": "ENFORCING",
        "decisionStrategy": "UNANIMOUS",
        "resources": [
          {
            "name": "Customers",
            "type": "urn:demo:customers",
            "uris": [
              "/api/customers",
              "/api/customers/*"
            ],
            "ownerManagedAccess": false,
            "scopes": [
              {
                "name": "read"
              }
            ]
          }
        ],
        "scopes": [
          {
            "name": "read"
          }
        ],
        "policies": [
          {
            "name": "Readers",
            "type": "role",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "roles": "[{\"id\": \"reader\", \"required\": true}]"
            }
          },
          {
            "name": "Read Customers",
            "type": "scope",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "resources": "[\"Customers\"]",
              "scopes": "[\"read\"]",
              "applyPolicies": "[\"Readers\"]"
            }
          }
        ]
      }
    },
    {
      "clientId": "order-api",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "demo-order-api-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": true,
      "fullScopeAllowed": true,
      "authorizationSettings": {
        "allowRemoteResourceManagement": true,
        "policyEnforcementMode": "ENFORCING",
        "decisionStrategy": "UNANIMOUS",
        "resources": [
          {
            "name": "Orders",
            "type": "urn:demo:orders",
            "uris": [
              "/api/orders",
              "/api/orders/*"
            ],
            "ownerManagedAccess": false,
            "scopes": [
              {
                "name": "read"
              },
              {
                "name": "update"
              },
              {
                "name": "delete"
              }
            ]
          }
        ],
        "scopes": [
          {
            "name": "read"
          },
          {
            "name": "update"
          },
          {
            "name": "delete"
          }
        ],
        "policies": [
          {
            "name": "Readers",
            "type": "role",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "roles": "[{\"id\": \"reader\", \"required\": true}]"
            }
          },
          {
            "name": "Read Orders",
            "type": "scope",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "resources": "[\"Orders\"]",
              "scopes": "[\"read\"]",
              "applyPolicies": "[\"Readers\"]"
            }
          },
          {
            "name": "Order managers",
            "type": "role",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "roles": "[{\"id\": \"order-manager\", \"required\": true}]"
            }
          },
          {
            "name": "Change orders",
            "type": "scope",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "resources": "[\"Orders\"]",
              "scopes": "[\"update\", \"delete\"]",
              "applyPolicies": "[\"Order managers\"]"
            }
          }
        ]
      }
    },
    {
      "clientId": "commerce-web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": [
        "http://localhost:5173/"
      ],
      "webOrigins": [
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email"
      ],
      "protocolMappers": [
        {
          "name": "audience-customer-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "customer-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "audience-order-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "order-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "commerce-postman",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": [
        "https://oauth.pstmn.io/v1/callback",
        "http://127.0.0.1:8765/callback"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email"
      ],
      "protocolMappers": [
        {
          "name": "audience-customer-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "customer-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "audience-order-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "order-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Demo",
      "email": "alice@example.test",
      "credentials": [
        {
          "type": "password",
          "value": "alice-demo-password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "reader"
      ]
    },
    {
      "username": "bob",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Demo",
      "email": "bob@example.test",
      "credentials": [
        {
          "type": "password",
          "value": "bob-demo-password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "reader",
        "order-manager"
      ]
    }
  ]
}
