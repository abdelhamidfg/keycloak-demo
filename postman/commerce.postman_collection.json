{
  "info": {
    "name": "Commerce demo \u2014 Keycloak authorization",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Read docs/postman.md first. Obtain Alice and Bob tokens using Authorization Code + PKCE in the collection Authorization tab. Set alice_token and bob_token locally in the environment. Restart Order API before running: the final tests delete O200. No password grant or client secret is used."
  },
  "auth": {
    "type": "oauth2",
    "oauth2": [
      {
        "key": "grant_type",
        "value": "authorization_code_with_pkce",
        "type": "string"
      },
      {
        "key": "authorizeUsingBrowser",
        "value": true,
        "type": "boolean"
      },
      {
        "key": "authUrl",
        "value": "{{keycloak_url}}/realms/commerce-demo/protocol/openid-connect/auth",
        "type": "string"
      },
      {
        "key": "accessTokenUrl",
        "value": "{{keycloak_url}}/realms/commerce-demo/protocol/openid-connect/token",
        "type": "string"
      },
      {
        "key": "clientId",
        "value": "commerce-postman",
        "type": "string"
      },
      {
        "key": "redirect_uri",
        "value": "https://oauth.pstmn.io/v1/callback",
        "type": "string"
      },
      {
        "key": "scope",
        "value": "openid profile email",
        "type": "string"
      },
      {
        "key": "code_challenge_method",
        "value": "S256",
        "type": "string"
      },
      {
        "key": "client_authentication",
        "value": "body",
        "type": "string"
      },
      {
        "key": "tokenName",
        "value": "Commerce demo user",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "01 Anonymous customer inquiry \u2192 401",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{customer_url}}/api/customers",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Anonymous order inquiry \u2192 401",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{order_url}}/api/orders",
