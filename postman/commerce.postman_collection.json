    {
      "name": "Alice: update O100 \u2192 403",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{order_url}}/api/orders/O100",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{alice_token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"status\": \"SHIPPED\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
