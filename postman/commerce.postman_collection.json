        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Status persisted\", () => pm.expect(pm.response.json().status).to.eql(\"SHIPPED\"));"
            ]
          }
        }
      ]
